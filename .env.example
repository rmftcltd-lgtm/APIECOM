PORT=3000
NODE_ENV=development

# OpenAI — used for vision analysis of photos + video frames
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Etsy Open API v3 — required only when publishing drafts to Etsy
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=
ETSY_SHIPPING_PROFILE_ID=
ETSY_RETURN_POLICY_ID=

# Pricing defaults (AUD). Override per shop in request body if needed.
DEFAULT_CURRENCY=AUD
DEFAULT_COUNTRY=AU
DEFAULT_MARKUP_PERCENT=45
DEFAULT_BASE_SHIPPING=8.5
DEFAULT_WEIGHT_SHIPPING_PER_KG=6

# Local storage
UPLOAD_DIR=./uploads
DATA_DIR=./data
MAX_PHOTO_BYTES=10485760
MAX_VIDEO_BYTES=52428800
